# ---------------------------------------------------------------------------
# Copy this file to .env.<TEST_ENV> (e.g. .env.uat, .env.staging, .env.live)
# and fill in the values for the application you are testing.
#
# To point this framework at a completely different project, this file is the
# only thing you need to change - no code edits required.
# ---------------------------------------------------------------------------

# Selects which .env file playwright.config.ts loads. Defaults to "uat".
TEST_ENV=uat

# --- Application under test -------------------------------------------------
# Base URL. Relative paths in tests (page.goto('/#appointment')) resolve here.
BASE_URL=https://katalon-demo-cura.herokuapp.com/

# Optional. Falls back to BASE_URL when unset.
# API_BASE_URL=https://api.example.com

# --- Credentials ------------------------------------------------------------
# Resolved lazily: only define the accounts your suite actually signs in as.
APP_USER_USERNAME=John Doe
APP_USER_PASSWORD=replace_me

# APP_ADMIN_USERNAME=Admin
# APP_ADMIN_PASSWORD=replace_me

# --- Timeouts (milliseconds) ------------------------------------------------
# Sensible defaults are built in; override only if the app is unusually slow.
# TIMEOUT_TEST=60000
# TIMEOUT_EXPECT=10000
# TIMEOUT_ACTION=15000
# TIMEOUT_NAVIGATION=30000

# --- Local developer conveniences -------------------------------------------
# LOG_LEVEL=info      # error | warn | info | debug
# HEADED=true         # watch the browser while tests run

# --- AI-assisted layer (entirely optional) ----------------------------------
# Everything below is OFF by default. With AI_ENABLED unset the suite makes
# zero AI calls and behaves exactly as it would without src/ai.
# The API key is read from the environment only and is never committed.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_ENABLED=false        # master switch; requires a key to have any effect
# AI_TRIAGE=true          # classify failures (default on once AI_ENABLED)
# AI_SELF_HEALING=false   # suggest replacement locators (opt in explicitly)
# AI_MODEL=claude-opus-5
# AI_EFFORT=low           # low | medium | high | xhigh | max
# AI_MAX_TOKENS=4096
# AI_TIMEOUT_MS=30000     # hard cap so a hung call cannot stall CI
# AI_OUTPUT_DIR=test-results/ai
