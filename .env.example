# Copy this file to .env.uat or .env.live and fill in real values.
# TEST_ENV selects which of those files playwright.config.ts loads (defaults to "uat").
TEST_ENV=uat

# Base URL of the application under test
BASE_URL=https://katalon-demo-cura.herokuapp.com/

# CURA Healthcare demo credentials
HEALTHCARE_ADMIN_USERNAME=Admin
HEALTHCARE_ADMIN_PASSWORD=your_admin_password
HEALTHCARE_CUST_USERNAME=John Doe
HEALTHCARE_CUST_PASSWORD=your_customer_password
