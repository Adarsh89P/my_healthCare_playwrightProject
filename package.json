{
  "name": "playwright-automation-framework",
  "version": "2.0.0",
  "description": "Reusable Playwright + TypeScript end-to-end test automation framework. Point it at any web application through environment configuration - no framework rebuild required.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:live": "cross-env TEST_ENV=live playwright test",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:serve": "allure serve allure-results",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml}\"",
    "verify": "npm run typecheck && npm run lint && npm run format:check",
    "clean": "rimraf test-results playwright-report allure-results allure-report blob-report playwright/.auth"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e-testing",
    "test-automation",
    "framework",
    "page-object-model",
    "sdet"
  ],
  "author": "Adarsh89p",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "allure-playwright": "^3.10.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.2.2",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "winston": "^3.19.0"
  }
}
